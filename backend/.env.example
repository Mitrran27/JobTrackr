# --- Neon (Console > your project > Connect) ---
# Pooled connection string (host contains "-pooler") used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- App ---
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"
# Frontend origin(s), comma separated. Used for CORS and links inside emails
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# --- Gmail SMTP (use an App Password, NOT your normal password) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="yourname@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Landed <yourname@gmail.com>"

# Daily reminder email time zone
TZ_NAME="Asia/Kuala_Lumpur"
